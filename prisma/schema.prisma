generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  MANAGER
  STAFF
}

model Customer {
  id        String    @id @default(cuid())
  email     String?   @unique
  phone     String?   @unique
  name      String
  addresses Address[]
  orders    Order[]
  wishlist  Wishlist?
  cart      Cart?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  street     String
  city       String
  state      String
  postalCode String
  country    String
  isDefault  Boolean  @default(false)
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id               String        @id @default(cuid())
  publicId         String        @unique // e.g., JWL-8F4K29X
  sku              String        @unique
  name             String
  slug             String        @unique
  description      String?
  shortDescription String?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  details   JewelryDetails?
  pricing   Pricing?
  inventory Inventory?
  images    ProductImage[]
  qrCode    QRCode?

  orderItems     OrderItem[]
  cartItems      CartItem[]
  productScans   ProductScan[]
  certifications Certification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model JewelryDetails {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  metalType   String // Gold, Silver, Platinum
  metalPurity String // 18K, 22K, 24K, 925
  grossWeight Float
  netWeight   Float
  stoneWeight Float?
  stoneType   String?
  stoneCount  Int     @default(0)
  stoneColor  String?
  diamondInfo String?

  hallmarkInfo String?
  huid         String?
}

model Certification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  certNumber  String
  authority   String // IGI, GIA, etc.
  issueDate   DateTime?
  documentUrl String?
}

model Pricing {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  basePrice         Float
  makingCharge      Float @default(0)
  stoneCharge       Float @default(0)
  discount          Float @default(0)
  gstPercentage     Float @default(3)
  finalSellingPrice Float
}

model Inventory {
  id        String  @id @default(cuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  stockQuantity     Int @default(0)
  availableQuantity Int @default(0)
  reservedQuantity  Int @default(0)
  soldQuantity      Int @default(0)

  warehouseLoc     String?
  reorderThreshold Int     @default(2)
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isMain    Boolean @default(false)
  sortOrder Int     @default(0)
}

model QRCode {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  qrData      String
  barcodeData String?
  createdAt   DateTime @default(now())
}

model ProductScan {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  scannedAt DateTime @default(now())
  ipHash    String? // Privacy safe anonymous tracking
  userAgent String?
}

model Order {
  id         String   @id @default(cuid())
  customerId String // Admin orders might not belong to registered Customer initially, but enforcing Customer relation
  customer   Customer @relation(fields: [customerId], references: [id])

  status         OrderStatus @default(PENDING)
  totalAmount    Float
  discountAmount Float       @default(0)
  taxAmount      Float
  finalAmount    Float

  paymentMethod String?
  paymentStatus String  @default("UNPAID") // UNPAID, PAID, FAILED

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
  price    Float
}

model Wishlist {
  id         String         @id @default(cuid())
  customerId String         @unique
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Int
}
